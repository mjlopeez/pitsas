# ---- Hub ECON ----
HUB_DB=./hub.db

# ---- Proteccion de los endpoints que MUTAN estado ----
# VACIO = todo abierto. Asi trabaja el equipo en local, sin tocar nada.
#
# ⚠️ LLENARLO EN CUANTO SE LEVANTE NGROK. En el momento en que la API deja de
# ser localhost, `POST /admin/reset` deja de ser una ayuda de desarrollo: borra
# eventos, alertas y traslados, y /docs publica la ruta para quien la quiera.
# Un curl de cualquiera deja el tablero en blanco en medio del pitch.
#
# Con esto puesto, los 9 mutadores (/admin/* y los 2 POST de sintetico) exigen
# la cabecera `X-Hub-Token`. Los GET NO se tocan: el Command Center sigue
# leyendo sin credencial y no hay que tocar el front.
#
#   HUB_ADMIN_TOKEN=poneme-algo-largo-y-random
#   curl -X POST -H "X-Hub-Token: poneme-algo-largo-y-random" .../admin/seed-ps
HUB_ADMIN_TOKEN=

# ---- Xiaomi MiMo (NER de notas de voz, OCR de tableros, transcripcion) ----
# Sin esta llave el Hub funciona COMPLETO con los respaldos por reglas:
# audios sembrados, extractor por expresiones regulares y OCR determinista.
# Esa es la red de seguridad contra el wifi del salon; no la quites.
MIMO_API_KEY=
# Las llaves de Token Plan traen una URL regional propia: copiala de la consola.
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL_TEXTO=mimo-v2.5-pro
MIMO_MODEL_MULTIMODAL=mimo-v2.5
MIMO_TIMEOUT=45

# ---- WhatsApp Cloud API (Emily la llena tras el alta en Meta) ----
WA_VERIFY_TOKEN=hub-econ-2026
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# ---- Ayuda de ensayo ----
# La veda del VMT corre de lunes a viernes. Si ensayas en fin de semana, el
# minuto 3 de la demo no dispara. 0=lunes .. 4=viernes. Si se usa en vivo, decirlo.
# HUB_DEMO_WEEKDAY=0

# ---- Prisma / Nexus (sandbox oficial del hackaton) ----
# El Hub funciona COMPLETO sin esto: la semilla alimenta la demo y el tablero
# declara en pantalla "datos simulados". Llenarlo solo despues de verlo
# funcionar en un ensayo.
PRISMA_BASE_URL=https://econ-key.maic.ai
PRISMA_EMAIL=
PRISMA_PASSWORD=

# ---- Startrack ----
# El API key sale de la interfaz: administrador de usuarios -> pestania
# "Integraciones (API)" (formato 22_5995decd5a025). La contrasenia es LA MISMA
# del login normal. El host es el dominio donde entras al sistema.
# Limite: 240 peticiones por IP cada 2 min, y /api/devices solo 10 cada 5 min.
STARTRACK_HOST=
STARTRACK_API_KEY=
STARTRACK_PASSWORD=

# Segundos sin reportar a partir de los cuales se considera "sin confirmacion".
# CRITERIO NUESTRO, no de la documentacion: una jornada completa.
# HUB_STARTRACK_UMBRAL_CONEXION=86400

# ---- Supuestos del sangrado (docs/SANGRADO.md) ----
# Ninguno sale de un documento de ECON. Estan aqui para poder decirle al
# jurado "cambiame este numero" y que el tablero responda.
# HUB_MIN_CONCILIACION=12
# HUB_COSTO_HORA_ADMIN=9.0
# HUB_COSTO_TRASLADO=380.0
# HUB_CONCILIACIONES_SEMANA=3
